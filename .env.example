# 复制本文件为 .env.production（不会提交 Git）
# npm run dev / npm run build / npm run ship:* 均读取 .env.production
#
# 本地开发：再复制下面「本地开发」段为 .env.production.local（已 gitignore，优先生效）
# 或直接把 VITE_DEV_PROXY_TARGET 改为 http://127.0.0.1:8080

# ---------- 本地开发（.env.production.local 推荐）----------
# 开发/联调直连 8.141.97.65（不要只写 /api，否则 Network 会显示 localhost:15173）
VITE_DEV_PROXY_TARGET=http://8.141.97.65
VITE_API_BASE=http://8.141.97.65/api
VITE_UPLOAD_ORIGIN=http://8.141.97.65
# 若改回本机 Docker：
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
# VITE_API_BASE=http://127.0.0.1:8080/api
# VITE_UPLOAD_ORIGIN=http://127.0.0.1:8080

# ---------- 生产环境（方案 A：80 端口 + 域名，不用 8088）----------
# Nginx 80 端口 /api/ → Docker frontend :28080
VITE_API_BASE=https://duanju.haodeweishi.cn/api
VITE_UPLOAD_ORIGIN=https://duanju.haodeweishi.cn
# 可选 TOS/CDN 公网 Origin，用于识别客户端已上传的对象存储 URL
# VITE_TOS_PUBLIC_ORIGIN=https://haode-ai.tos-cn-beijing.volces.com

# ---------- 安装包分发：推荐 TOS（不走 5M 服务器带宽）----------
RELEASE_STORAGE=tos
TOS_BUCKET=haode-ai
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
# 建议子账号 AK/SK，权限仅 releases/client/download/* 读写
TOS_ACCESS_KEY=你的AccessKey
TOS_SECRET_KEY=你的SecretKey
TOS_PUBLIC_BASE_URL=https://haode-ai.tos-cn-beijing.volces.com
TOS_RELEASE_PREFIX=releases/client/download
# 自动更新 feed + 安装包直链（TOS 发版；与侧边栏「官网」无关）
VITE_UPDATE_PUBLISH_URL=https://haode-ai.tos-cn-beijing.volces.com/releases/client/download
# 侧边栏「官网」→ 产品落地页（HTML，勿填 TOS 地址）
VITE_OFFICIAL_WEBSITE_URL=https://duanju.haodeweishi.cn/haode-client/download/
# 侧边栏公众号二维码（二选一）
# 1) 将公众平台下载的二维码保存为 public/wechat-official-qr.png（推荐）
# 2) 或配置 TOS/CDN 图片地址：
# VITE_WECHAT_OFFICIAL_QR_URL=https://haode-ai.tos-cn-beijing.volces.com/static/wechat-official-qr.png
# VITE_WECHAT_OFFICIAL_NAME=浩德微视
# 侧边栏抖音号二维码（二选一）
# 1) 将抖音号二维码保存为 public/douyin-official-qr.png（推荐）
# 2) 或配置 TOS/CDN 图片地址：
# VITE_DOUYIN_OFFICIAL_QR_URL=https://haode-ai.tos-cn-beijing.volces.com/static/douyin-official-qr.png
# VITE_DOUYIN_OFFICIAL_NAME=浩德微视
# 若仍走服务器 SFTP：RELEASE_STORAGE=server 并保留下面 DEPLOY_*
# VITE_UPDATE_PUBLISH_URL=https://duanju.haodeweishi.cn/haode-client/download
# 仅用 IP 时可改为：
# VITE_API_BASE=http://115.191.9.56/api
# VITE_UPLOAD_ORIGIN=http://115.191.9.56
# VITE_UPDATE_PUBLISH_URL=http://115.191.9.56/haode-client/download
# 默认走联调 8.141.97.65；本地 Docker 时在 .env.production.local 覆盖为 http://127.0.0.1:28080
VITE_DEV_PROXY_TARGET=http://8.141.97.65
VITE_APP_ENV=production

# ---------- 登录（一期：仅账号密码）----------
# VITE_LOGIN_REQUIRED=true
# VITE_AUTH_ACCOUNT_ENABLED=true
# VITE_AUTH_WECHAT_ENABLED=false
# VITE_AUTH_SMS_ENABLED=false

# 本机发版上传（npm run upload / ship:win）
# TOS 模式：安装包走 TOS，仅 website/ 小文件可选 SFTP 到服务器
# DEPLOY_HOST=115.191.9.56
# DEPLOY_USER=root
# DEPLOY_PASSWORD=你的root密码
# DEPLOY_UPDATE_PATH=/opt/haode-client/download
# UPLOAD_WEBSITE_TO_SERVER=1
# UPLOAD_SKIP_CHOWN=1
# TOS_KEEP_INSTALLER_VERSIONS=5

# ---------- 下载页外链（可选覆盖 build 默认）----------
# 默认：windowsUrl=官网下载页，windowsDirectUrl=TOS/官网 exe 直链（由 build 自动写入）
# DOWNLOAD_WINDOWS_URL=https://duanju.haodeweishi.cn/haode-client/download/
# DOWNLOAD_WINDOWS_DIRECT_URL=https://haode-ai.tos-cn-beijing.volces.com/releases/client/download/好的漫创 Setup x.x.x.exe
# DOWNLOAD_MAC_URL=
# 仅上传下载页（不上传 exe）：UPLOAD_WEBSITE_ONLY=1

# Mac 本机打包：arm64 dmg 手动更新（不打/不传 zip）
# BUILD_MAC_ARCH=arm64
# BUILD_MAC_SKIP_ZIP=1
# UPLOAD_MAC_SKIP_ZIP=1
# Mac dmg 不上传生产服务器（BUILD_MAC_SKIP_SERVER_UPLOAD=1）
