# 本地漫创 · 环境变量示例
# 复制为 .env.production 或 .env.production.local（勿提交密钥）
#
# 开源版默认：不连公司后端。生成能力靠你在设置里配置的模型 Endpoint + Key。

# ---------- 可选：自建后端（一般可留空）----------
# VITE_API_BASE=
# VITE_UPLOAD_ORIGIN=
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:28080

# ---------- 可选：自动更新 / 官网（P6 再配自己的 Gitee/云）----------
# VITE_UPDATE_PUBLISH_URL=
# VITE_OFFICIAL_WEBSITE_URL=
# VITE_UPDATE_ORIGIN=

VITE_APP_ENV=development
